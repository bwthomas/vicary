__pycache__/
*.py[cod]
*.egg-info/

# Build output, listed per package and ALWAYS anchored.
#
# Never write these as bare `build/` or `dist/`. An unanchored `build/` also
# matches `python/src/vicary/build/` — the gazetteer builder — and silently kept
# it out of all 17 commits before the first push. A local run cannot see it: the
# files are on disk either way, imports resolve, and setuptools even puts them in
# a locally built wheel, because it reads the working tree rather than the index.
# `python/tests/test_packaging.py` is the guard; this comment is why it exists.
#
# Adding a language means adding its output here, anchored, not relaxing these.
/python/build/
/python/dist/
/python/.venv/
/typescript/dist/
/typescript/dist-test/
/typescript/node_modules/
/ruby/pkg/
/ruby/*.gem

# Vendored asset copies. Reproduced from python/src/vicary/data by each package's
# sync step, and NOT tracked: a second tracked copy is a second thing to bump per
# asset cut, which is how two front doors end up shipping different gazetteers.
/typescript/assets/
/ruby/assets/

.tox/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
