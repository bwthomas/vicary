  "conventions": {
    "kind": "upper-cased, brackets and spaces stripped, any _n suffix dropped; a kind not in `kinds` is reported as `other_kind`",
    "offsets": "start and end count code points, not UTF-16 code units",
    "scrub_prose": "drop each sentence carrying a placeholder and join the rest with single spaces; when every sentence carries one, replace each placeholder with its generic stand-in (`this` when none is listed)",
    "scrub_quote": "replace each placeholder with an ellipsis, collapse the whitespace around every ellipsis to one space, close it up before punctuation, and trim"
  },
